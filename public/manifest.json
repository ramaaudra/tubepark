{
  "manifest_version": 3,
  "name": "TubePark — Frictionless Visual Scratchpad for YouTube",
  "version": "0.1.0",
  "description": "Convert a horizontal tab-bar mess into a vertical, thumbnail-rich queue.",
  "permissions": [
    "storage",
    "alarms",
    "contextMenus",
    "tabs",
    "notifications",
    "sidePanel"
  ],
  "host_permissions": [
    "*://*.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "TubePark"
  },
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
